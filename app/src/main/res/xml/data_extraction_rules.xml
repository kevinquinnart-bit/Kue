<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup of KueSounds (Android 12 and newer), to the person's Google account and when moving
     to a new phone: the music's details as read and looked up, changes, podcast shows and where each episode got
     to, settings. Not the Google sign-in. Free, private, not counted against the person's Drive space. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="library.json" />
        <include domain="file" path="changes.json" />
        <include domain="file" path="podcast-shows.json" />
        <include domain="sharedpref" path="podcasts.xml" />
        <include domain="sharedpref" path="podcast-positions.xml" />
        <include domain="sharedpref" path="notices.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="library.json" />
        <include domain="file" path="changes.json" />
        <include domain="file" path="podcast-shows.json" />
        <include domain="sharedpref" path="podcasts.xml" />
        <include domain="sharedpref" path="podcast-positions.xml" />
        <include domain="sharedpref" path="notices.xml" />
    </device-transfer>
</data-extraction-rules>
