<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own backup of KueVault's set-up (Android 12 and newer), to the person's Google account and when
     moving to a new phone: the places, where each section lives and keeps its copies, and the library list.
     Google keeps it free and private, and it doesn't count against the person's Drive space. Not home-computer
     passwords: locked to this phone's key; KueVault asks for them again on the new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="vault.xml" />
        <include domain="file" path="library.json" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="vault.xml" />
        <include domain="file" path="library.json" />
    </device-transfer>
</data-extraction-rules>
